{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host_root",
    "implementation_bundle",
    "trusted_modified_receipt_sha256",
    "reviewed_package_source_sha256",
    "reviewed_configuration_sha256",
    "interpreter",
    "wheelhouse",
    "package_directory",
    "environment_parent",
    "console_script",
    "build_tools",
    "wheels",
    "requirements",
    "configuration",
    "secret_references",
    "template_directories"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "host_root": {
      "type": "string",
      "minLength": 1
    },
    "implementation_bundle": {
      "type": "string",
      "minLength": 1
    },
    "trusted_modified_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewed_package_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewed_configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interpreter": {
      "type": "string",
      "minLength": 1
    },
    "wheelhouse": {
      "type": "string",
      "minLength": 1
    },
    "package_directory": {
      "type": "string",
      "minLength": 1
    },
    "environment_parent": {
      "type": "string",
      "minLength": 1
    },
    "console_script": {
      "type": "string",
      "minLength": 1
    },
    "build_tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pip",
        "setuptools",
        "wheel"
      ],
      "properties": {
        "pip": {
          "type": "string",
          "minLength": 1
        },
        "setuptools": {
          "type": "string",
          "minLength": 1
        },
        "wheel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "wheels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "sha256"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "pattern": "^[^/\\\\]+\\.whl$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "wheel",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]*$"
          },
          "wheel": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jev_runtime"
      ],
      "properties": {
        "jev_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "credential_ref"
          ],
          "properties": {
            "mode": {
              "const": "off"
            },
            "credential_ref": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
                }
              ]
            }
          }
        }
      }
    },
    "secret_references": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "template_directories": {
      "maxProperties": 2,
      "minProperties": 2,
      "type": "object",
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      }
    }
  }
}
