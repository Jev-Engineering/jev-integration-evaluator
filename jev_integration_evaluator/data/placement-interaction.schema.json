{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded pairwise placement interaction",
  "type": "object",
  "properties": {
    "a": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "b": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "hypothesis",
        "assumed",
        "unknown",
        "measured"
      ]
    },
    "utility_delta": {
      "type": "number"
    },
    "conflict": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    },
    "validation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    }
  },
  "required": [
    "a",
    "b",
    "status",
    "utility_delta",
    "conflict"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "measured"
          }
        }
      },
      "then": {
        "required": [
          "provenance"
        ]
      }
    }
  ]
}
