{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:observed-placement-set:1.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "selected_candidate_ids": {"type": "array", "minItems": 1, "maxItems": 1,
      "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reviewed_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema_version", "selected_candidate_ids", "reviewed_inventory_sha256", "selection_sha256", "contract_digest"],
  "additionalProperties": false
}
