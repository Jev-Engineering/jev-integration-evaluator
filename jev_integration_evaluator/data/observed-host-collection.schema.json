{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:observed-host-collection:1.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "host_paired_collection"},
    "link_digest": {"$ref": "#/$defs/hash"},
    "study_digest": {"$ref": "#/$defs/hash"},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "input_manifest_sha256": {"$ref": "#/$defs/hash"},
    "labels_sha256": {"$ref": "#/$defs/hash"},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_contract_digest": {"$ref": "#/$defs/hash"},
    "host_scope_digest": {"$ref": "#/$defs/hash"},
    "egress_grant_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "status": {"enum": ["synthetic_complete", "observed_collected_unverified_origin", "incomplete_scheduled_outcomes", "incomplete_unresolved_host_attempt", "incomplete_egress_scope", "incomplete_unknown_budget", "incomplete_bound_insufficient"]},
    "evidence_type": {"enum": ["synthetic", "observed"]},
    "scheduled_pairs": {"type": "integer", "minimum": 1},
    "collected_pairs": {"type": "integer", "minimum": 0},
    "missing_pairs": {"type": "array", "items": {"type": "object", "properties": {
      "task_id": {"type": "string", "minLength": 1}, "replicate": {"type": "integer", "minimum": 0}
    }, "required": ["task_id", "replicate"], "additionalProperties": false}},
    "baseline": {"type": "array", "items": {"type": "object"}},
    "jev": {"type": "array", "items": {"type": "object"}},
    "host_pair_calls": {"type": "integer", "minimum": 0},
    "recorded_cost": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "receipt_hashes": {"type": "array", "items": {"type": "object", "properties": {
      "task_id": {"type": "string", "minLength": 1}, "replicate": {"type": "integer", "minimum": 0},
      "receipt_sha256": {"$ref": "#/$defs/hash"}
    }, "required": ["task_id", "replicate", "receipt_sha256"], "additionalProperties": false}},
    "independent_label_count": {"type": "integer", "minimum": 0},
    "provider_connectivity": {"const": "not_established"},
    "benefit_supported": {"const": false},
    "activation_eligible": {"const": false},
    "contract_digest": {"$ref": "#/$defs/hash"}
  },
  "required": ["schema_version", "kind", "link_digest", "study_digest", "request_sha256",
    "input_manifest_sha256", "labels_sha256", "adapter_id", "adapter_contract_digest",
    "host_scope_digest", "egress_grant_sha256", "status", "evidence_type", "scheduled_pairs",
    "collected_pairs", "missing_pairs", "baseline", "jev", "host_pair_calls", "recorded_cost",
    "receipt_hashes", "independent_label_count", "provider_connectivity", "benefit_supported",
    "activation_eligible", "contract_digest"],
  "additionalProperties": false,
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
