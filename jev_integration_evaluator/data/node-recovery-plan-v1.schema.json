{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Node recipe C owned interruption recovery plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "target", "step_plan_sha256", "root", "stage", "intent_sha256", "root_identity", "journal", "generation_sha256", "entries", "recovery_journal_head", "operations", "mode", "runtime_activation_authorized", "recovery_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "node-recovery-plan-v1"},
    "target": {"enum": ["package", "generation"]},
    "step_plan_sha256": {"$ref": "#/$defs/sha"},
    "root": {"type": "string", "pattern": "^/"},
    "stage": {"enum": ["intent_recorded", "directory_created", "owner_marked", "journal_recorded"]},
    "intent_sha256": {"$ref": "#/$defs/sha"},
    "root_identity": {"oneOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false, "required": ["device", "inode"],
      "properties": {"device": {"type": "integer", "minimum": 0},
                     "inode": {"type": "integer", "minimum": 0}}}]},
    "journal": {"type": "array", "maxItems": 2, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "previous", "plan_sha256", "event", "record_sha256"],
      "properties": {"sequence": {"type": "integer", "minimum": 0, "maximum": 1},
                     "previous": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
                     "plan_sha256": {"$ref": "#/$defs/sha"},
                     "event": {"enum": ["build_started", "build_complete", "install_started", "install_complete"]},
                     "record_sha256": {"$ref": "#/$defs/sha"}}}},
    "generation_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "entries": {"type": "integer", "minimum": 0, "maximum": 50000},
    "recovery_journal_head": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "operations": {"type": "array", "minItems": 3, "maxItems": 4, "uniqueItems": true,
                   "items": {"enum": ["record_recovery_start", "remove_owned_root", "record_recovery_complete", "remove_ownership_intent"]}},
    "mode": {"const": "off"}, "runtime_activation_authorized": {"const": false},
    "recovery_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
