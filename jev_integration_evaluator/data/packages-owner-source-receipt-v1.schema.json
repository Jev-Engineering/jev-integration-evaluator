{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "plan_sha256",
    "transaction_directory",
    "action",
    "owner_file_sha256",
    "target_executed",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "packages-owner-source-receipt-v1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transaction_directory": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "applied",
        "rolled_back"
      ]
    },
    "owner_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_executed": {
      "const": false
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
