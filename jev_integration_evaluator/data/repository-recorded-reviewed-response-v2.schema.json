{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:repository-recorded-reviewed-response-v2:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "adapter": {
      "const": "recorded-reviewed-input-v2"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory": {
      "type": "object"
    },
    "spec": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "adapter",
    "request_sha256",
    "inventory",
    "spec"
  ],
  "additionalProperties": false
}
