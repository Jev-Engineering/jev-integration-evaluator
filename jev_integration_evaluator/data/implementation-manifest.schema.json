{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:implementation-manifest:1.0",
  "type": "object",
  "properties": {
    "host_lifecycle": {
      "type": "object",
      "properties": {
        "kind": {"const": "module-startup-v1"},
        "startup": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
        "shutdown": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
        "complete_task": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"}
      },
      "required": ["kind", "startup", "shutdown", "complete_task"],
      "additionalProperties": false
    },
    "entry_point": {
      "type": "string",
      "minLength": 1
    },
    "baseline_symbol": {
      "type": "string",
      "minLength": 1
    },
    "adapter_symbol": {
      "type": "string",
      "minLength": 1
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_shape": {
      "const": "module-tail-call-v1"
    },
    "recipe_contract": {
      "type": "string",
      "minLength": 1
    },
    "required_bindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 8,
      "maxItems": 20,
      "uniqueItems": true
    },
    "imports_resolved_by": {
      "const": "installed evaluator wheel when enabled"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "original_discovery_source": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parser": {
          "enum": [
            "python_ast",
            "typescript_ast",
            "lexical_review_only"
          ]
        }
      },
      "required": [
        "file",
        "symbol",
        "start_line",
        "end_line",
        "file_sha256",
        "source_sha256",
        "parser"
      ],
      "additionalProperties": false
    },
    "binding_review": {
      "type": "object",
      "properties": {
        "approved": {
          "const": true
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pattern": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G",
            "H",
            "I",
            "J",
            "K",
            "L",
            "M"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "approved",
        "source_sha256",
        "pattern",
        "reviewer",
        "reason"
      ],
      "additionalProperties": false
    },
    "wiring_status": {
      "const": "planned_not_applied"
    },
    "activation_authorized": {
      "const": false
    },
    "package_binding": {
      "type": "object",
      "properties": {
        "version": {
          "const": "1.0"
        },
        "namespace": {
          "type": "boolean"
        },
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*(\\.[A-Za-z_][A-Za-z_0-9]*)+$",
          "maxLength": 256
        }
      },
      "required": [
        "version",
        "namespace",
        "module"
      ],
      "additionalProperties": false
    },
    "entrypoint_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "kind", "script", "module", "function", "file", "file_sha256", "pyproject_sha256", "request_symbol", "item_symbol", "task_symbol", "startup_inputs", "contributing_sources"],
      "properties": {
        "version": {"const": "1.0"},
        "kind": {"enum": ["single-request-v1", "task-loop-v1"]},
        "script": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "module": {"type": "string", "minLength": 3, "maxLength": 256},
        "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
        "file": {"type": "string", "minLength": 4, "maxLength": 256},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pyproject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
        "item_symbol": {"type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
        "task_symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
        "startup_inputs": {
          "type": "object", "additionalProperties": false,
          "required": ["budget_limits", "audit_log", "dependency_plan", "startup_options"],
          "properties": {
            "budget_limits": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
            "audit_log": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
            "dependency_plan": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
            "startup_options": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"}
          }
        },
        "contributing_sources": {"type": "object", "minProperties": 2,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "contributing_sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z_0-9/]*\\.py$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minProperties": 1
    },
    "qualified_bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z_]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z_0-9]*(\\.[A-Za-z_][A-Za-z_0-9]*)*:[A-Za-z_][A-Za-z_0-9]*$"
      },
      "minProperties": 8
    }
  },
  "required": [
    "entry_point",
    "baseline_symbol",
    "adapter_symbol",
    "binding_digest",
    "source_shape",
    "recipe_contract",
    "required_bindings",
    "imports_resolved_by",
    "candidate_id",
    "experiment_id",
    "original_discovery_source",
    "binding_review",
    "wiring_status",
    "activation_authorized"
  ],
  "additionalProperties": false
}
