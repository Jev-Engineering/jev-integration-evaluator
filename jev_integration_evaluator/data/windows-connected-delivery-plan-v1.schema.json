{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "install_plan_sha256", "trusted_package_receipt_sha256", "trusted_install_receipt_sha256", "installed_binding_sha256", "cng", "reference_owner", "observation_owner", "reference_sha256", "launch_environment", "observation", "requested_mode", "runtime_activation_authorized", "provider_reachable", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "windows-connected-delivery-plan-v1"},
    "install_plan_sha256": {"$ref": "#/$defs/sha"},
    "trusted_package_receipt_sha256": {"$ref": "#/$defs/sha"},
    "trusted_install_receipt_sha256": {"$ref": "#/$defs/sha"},
    "installed_binding_sha256": {"$ref": "#/$defs/sha"},
    "cng": {"type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "volume_id", "file_id", "nlink", "acl_sha256"],
      "properties": {"path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"}, "volume_id": {"type": "integer", "minimum": 1},
        "file_id": {"type": "integer", "minimum": 1}, "nlink": {"type": "integer", "minimum": 1},
        "acl_sha256": {"$ref": "#/$defs/sha"}}},
    "reference_owner": {"$ref": "#/$defs/owner"},
    "observation_owner": {"$ref": "#/$defs/owner"},
    "reference_sha256": {"type": "object", "additionalProperties": false,
      "required": ["REGISTERED_ALPHA_AUTH_PUBKEY_FILE", "REGISTERED_ALPHA_CONNECTED_REF"],
      "properties": {"REGISTERED_ALPHA_AUTH_PUBKEY_FILE": {"$ref": "#/$defs/sha"},
                     "REGISTERED_ALPHA_CONNECTED_REF": {"$ref": "#/$defs/sha"},
                     "SSL_CERT_FILE": {"$ref": "#/$defs/sha"}}},
    "launch_environment": {"type": "object", "additionalProperties": false,
      "required": ["REGISTERED_ALPHA_AUTH_PUBKEY_FILE", "REGISTERED_ALPHA_CONNECTED_REF"],
      "properties": {"REGISTERED_ALPHA_AUTH_PUBKEY_FILE": {"type": "string", "minLength": 1},
                     "REGISTERED_ALPHA_CONNECTED_REF": {"type": "string", "minLength": 1},
                     "REGISTERED_ALPHA_OBSERVATION_ACL_SHA256": {"$ref": "#/$defs/sha"},
                     "REGISTERED_ALPHA_REFERENCE_ACL_SHA256": {"$ref": "#/$defs/sha"},
                     "REGISTERED_ALPHA_PERMIT": {"enum": ["0", "1"]},
                     "REGISTERED_ALPHA_HOLD": {"enum": ["0", "1"]},
                     "REGISTERED_ALPHA_AUDIT": {"type": "string", "minLength": 1},
                     "REGISTERED_ALPHA_EFFECTS": {"type": "string", "minLength": 1},
                     "REGISTERED_ALPHA_TASK_ID": {"type": "string", "minLength": 1},
                     "REGISTERED_ALPHA_READY": {"type": "string", "minLength": 1},
                     "REGISTERED_ALPHA_RELEASE": {"type": "string", "minLength": 1},
                     "REGISTERED_ALPHA_ENTRYPOINT": {"type": "string", "minLength": 1},
                     "REGISTERED_ALPHA_INTEGRATION": {"type": "string", "minLength": 1},
                     "SSL_CERT_FILE": {"type": "string", "minLength": 1}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["checks"],
      "properties": {"checks": {"type": "array", "minItems": 4, "maxItems": 4,
        "items": {"type": "object", "additionalProperties": false,
          "required": ["role", "path", "before_sha256", "after_sha256"],
          "properties": {"role": {"enum": ["ready", "entrypoint_reached", "integration_reachable", "outcome_verified"]},
                         "path": {"type": "string", "minLength": 1},
                         "before_sha256": {"$ref": "#/$defs/sha"}, "after_sha256": {"$ref": "#/$defs/sha"}}}}}},
    "requested_mode": {"const": "shadow"}, "runtime_activation_authorized": {"const": false},
    "provider_reachable": {"type": "null"}, "plan_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "owner": {"type": "object", "additionalProperties": false,
      "required": ["path", "volume_id", "file_id", "acl_sha256", "lock_acl_sha256"],
      "properties": {"path": {"type": "string", "minLength": 1},
                     "volume_id": {"type": "integer", "minimum": 1}, "file_id": {"type": "integer", "minimum": 1},
                     "acl_sha256": {"$ref": "#/$defs/sha"}, "lock_acl_sha256": {"$ref": "#/$defs/sha"}}}
  }
}
