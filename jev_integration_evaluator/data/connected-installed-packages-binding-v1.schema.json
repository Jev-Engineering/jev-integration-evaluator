{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Two independently installed package origins under one explicit owner root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "candidate_ids",
    "site",
    "members",
    "distributions",
    "source_plan",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "connected-installed-packages-binding-v1"
    },
    "candidate_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "site": {
      "type": "string",
      "minLength": 1
    },
    "members": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/member"
      }
    },
    "distributions": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "version"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 10,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        }
      }
    },
    "binding_sha256": {
      "$ref": "#/$defs/sha"
    },
    "owner": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_plan_sha256",
        "package_receipt_sha256",
        "install_plan_sha256",
        "install_receipt_sha256",
        "owner_source_plan_sha256",
        "wheel_sha256",
        "installed_files_sha256",
        "binding_sha256",
        "schema_version",
        "kind",
        "environment",
        "site",
        "origins",
        "source_plan"
      ],
      "properties": {
        "package_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "package_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "install_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "install_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "owner_source_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "wheel_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "installed_files_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "connected-installed-owner-binding-v1"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "site": {
          "type": "string",
          "minLength": 1
        },
        "origins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "console",
            "command",
            "evaluator",
            "project"
          ],
          "properties": {
            "console": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "command": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "evaluator": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "project": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "source_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "wheel_member"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "wheel_member": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "candidate_id",
        "source_file",
        "reviewed_file_sha256",
        "applied_file_sha256",
        "package_plan_sha256",
        "package_receipt_sha256",
        "install_plan_sha256",
        "install_receipt_sha256",
        "wheel_sha256",
        "installed_files_sha256",
        "site",
        "origins",
        "reviewed_project_path",
        "reviewed_project_sha256",
        "source_plan",
        "binding_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "connected-installed-binding-v1"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_file_sha256": {
          "$ref": "#/$defs/sha"
        },
        "applied_file_sha256": {
          "$ref": "#/$defs/sha"
        },
        "package_plan_sha256": {
          "$ref": "#/$defs/sha"
        },
        "package_receipt_sha256": {
          "$ref": "#/$defs/sha"
        },
        "install_plan_sha256": {
          "$ref": "#/$defs/sha"
        },
        "install_receipt_sha256": {
          "$ref": "#/$defs/sha"
        },
        "wheel_sha256": {
          "$ref": "#/$defs/sha"
        },
        "installed_files_sha256": {
          "$ref": "#/$defs/sha"
        },
        "site": {
          "type": "string",
          "minLength": 1
        },
        "origins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "adapter",
            "console"
          ],
          "properties": {
            "host": {
              "$ref": "#/$defs/origin"
            },
            "adapter": {
              "$ref": "#/$defs/origin"
            },
            "console": {
              "$ref": "#/$defs/origin"
            },
            "loader": {
              "$ref": "#/$defs/origin"
            }
          }
        },
        "reviewed_project_path": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_project_sha256": {
          "$ref": "#/$defs/sha"
        },
        "source_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 4,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha"
                  }
                }
              }
            }
          }
        },
        "binding_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "owner"
        ]
      },
      "else": {
        "properties": {
          "source_plan": {
            "properties": {
              "files": {
                "maxItems": 266
              }
            }
          }
        }
      }
    }
  ]
}
