{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "template-delivery-observation-v1"},
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path", "before_sha256", "expected_sha256"],
        "properties": {
          "role": {"enum": ["ready", "entrypoint_reached", "integration_reachable", "outcome_verified"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "before_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
          "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
