{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "template_id", "template_version", "manifest_sha256", "evaluator_version", "renderer_sha256", "tool_sha256", "request_sha256", "inventory_sha256", "spec_sha256", "source_sha256", "source_file_sha256", "policy_sha256", "candidate_id", "recipe", "lifecycle", "target_modified", "target_executed", "owned_resources", "planner", "lock_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "materialized"},
    "template_id": {"const": "python.bounded-tail-call"},
    "template_version": {"const": "1.0.0"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "evaluator_version": {"type": "string", "minLength": 1},
    "renderer_sha256": {"$ref": "#/$defs/digest"},
    "tool_sha256": {"$ref": "#/$defs/digest"},
    "request_sha256": {"$ref": "#/$defs/digest"},
    "inventory_sha256": {"$ref": "#/$defs/digest"},
    "spec_sha256": {"$ref": "#/$defs/digest"},
    "source_sha256": {"$ref": "#/$defs/digest"},
    "source_file_sha256": {"$ref": "#/$defs/digest"},
    "policy_sha256": {"$ref": "#/$defs/digest"},
    "candidate_id": {"type": "string", "minLength": 1},
    "recipe": {"type": "object", "additionalProperties": false, "required": ["id", "version", "shape"], "properties": {"id": {"pattern": "^python\\.[A-M]$", "type": "string"}, "version": {"const": "1.0"}, "shape": {"const": "module-tail-call-v1"}}},
    "lifecycle": {"type": "object", "additionalProperties": false,
      "required": ["selection", "parameter_validation", "generation", "materialization", "binding_adaptation", "planning", "baseline", "apply", "build", "install", "configure", "launch", "entrypoint_reachability", "connectivity", "verification", "status", "disable", "stop", "upgrade", "rollback", "authorized_mode", "shadow_mode", "canary_mode", "active_mode", "measured_benefit"],
      "properties": {
        "selection": {"const": "requires_current_review"},
        "parameter_validation": {"const": "supported"},
        "generation": {"const": "supported"},
        "materialization": {"const": "supported"},
        "binding_adaptation": {"const": "requires_existing_planner"},
        "planning": {"const": "requires_existing_planner"},
        "baseline": {"const": "pending_separate_execution_authority"},
        "apply": {"const": "pending_separate_approval"},
        "build": {"const": "unsupported_by_renderer"},
        "install": {"const": "unsupported_by_renderer"},
        "configure": {"const": "unsupported_by_renderer"},
        "launch": {"const": "unsupported_by_renderer"},
        "entrypoint_reachability": {"const": "pending_host_test"},
        "connectivity": {"const": "pending_separate_authority"},
        "verification": {"const": "pending_authorized_host_test"},
        "status": {"const": "render_status_only"},
        "disable": {"const": "host_control_required"},
        "stop": {"const": "host_control_required"},
        "upgrade": {"const": "fresh_request_required"},
        "rollback": {"const": "target_rollback_requires_existing_lifecycle"},
        "authorized_mode": {"const": "off"},
        "shadow_mode": {"const": "pending_separate_authority"},
        "canary_mode": {"const": "pending_separate_authority"},
        "active_mode": {"const": "pending_separate_authority"},
        "measured_benefit": {"const": "unknown"}
      }
    },
    "target_modified": {"const": false},
    "target_executed": {"const": false},
    "owned_resources": {"type": "object", "additionalProperties": false,
      "required": ["template-manifest.json", "template-request.json", "implementation-spec.json", "reviewed-inventory.json"],
      "properties": {"template-manifest.json": {"$ref": "#/$defs/digest"}, "template-request.json": {"$ref": "#/$defs/digest"}, "implementation-spec.json": {"$ref": "#/$defs/digest"}, "reviewed-inventory.json": {"$ref": "#/$defs/digest"}}},
    "planner": {"type": "object", "additionalProperties": false, "required": ["command", "inventory", "spec", "candidate", "output"], "properties": {"command": {"const": "implement-plan"}, "inventory": {"const": "reviewed-inventory.json"}, "spec": {"const": "implementation-spec.json"}, "candidate": {"type": "string", "minLength": 1}, "output": {"type": "string", "minLength": 1}}},
    "lock_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
