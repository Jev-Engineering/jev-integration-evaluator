{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "request_sha256", "reviewer", "reason", "shape", "adapter_file", "adapter_name", "evidence", "unresolved"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "offline-adaptation-proposal-v1"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 256},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "shape": {"enum": ["instance-method-tail-call-v1", "async-module-tail-call-v1"]},
    "adapter_file": {"type": "string", "minLength": 1, "maxLength": 256},
    "adapter_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file", "sha256", "symbol"],
        "properties": {
          "file": {"type": "string", "minLength": 1, "maxLength": 256},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "symbol": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "unresolved": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"enum": ["ambiguous_callback", "missing_independent_observation", "unsupported_binding", "missing_host_capability"]}
    }
  }
}
