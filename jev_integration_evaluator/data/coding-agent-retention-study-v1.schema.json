{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:coding-agent-retention-study:1",
  "type": "object",
  "required": ["schema_version", "status", "candidate", "source_base_commit", "assignment_seed", "splits", "frozen_input_sha256"],
  "properties": {
    "schema_version": {"const": "coding-agent-retention-study-v1"},
    "status": {"enum": ["prepared_pending_independent_review", "independently_reviewed"]},
    "candidate": {"const": "JEV-594296255D6E"},
    "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "assignment_seed": {"const": 490146},
    "splits": {"type": "object", "required": ["calibration", "holdout"], "properties": {
      "calibration": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^c[0-9]{2}$"}},
      "holdout": {"type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^h[0-9]{2}$"}}
    }},
    "frozen_input_sha256": {"type": "object", "required": ["source", "runner", "oracle", "histories", "reader_questions", "scorer", "proposals", "injections", "attacks", "projection", "policy", "report_schema"], "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
