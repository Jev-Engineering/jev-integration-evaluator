{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:coding-agent-retention-report:1",
  "type": "object",
  "required": ["schema_version", "kind", "split", "candidate", "input_sha256", "study_spec_sha256", "rows", "summary", "jev_paired_effects", "resource_note", "comparison_note", "decision", "live_adoption"],
  "properties": {
    "schema_version": {"const": "coding-agent-retention-report-v1"},
    "kind": {"const": "offline_synthetic_fixture"},
    "split": {"enum": ["calibration", "holdout"]},
    "candidate": {"const": "JEV-594296255D6E"},
    "input_sha256": {"type": "object", "required": ["source", "runner", "oracle", "histories", "reader_questions", "scorer", "proposals", "injections", "attacks", "projection", "policy", "report_schema"], "additionalProperties": {"$ref": "#/$defs/hash"}},
    "study_spec_sha256": {"$ref": "#/$defs/hash"},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "mode", "arm_order", "arms"], "properties": {
      "id": {"type": "string", "pattern": "^[ch][0-9]{2}$"},
      "mode": {"type": "string"},
      "arm_order": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["current", "deterministic", "jev"]}},
      "arms": {"type": "object", "required": ["current", "deterministic", "jev"], "properties": {
        "current": {"anyOf": [{"$ref": "#/$defs/arm"}, {"type": "object", "required": ["status"], "properties": {"status": {"const": "not_applicable_no_historical_mode"}}}]},
        "deterministic": {"$ref": "#/$defs/arm"}, "jev": {"$ref": "#/$defs/arm"}
      }, "additionalProperties": false}
    }}},
    "summary": {"type": "object", "required": ["current", "deterministic", "jev"], "properties": {
      "current": {"$ref": "#/$defs/summary_arm"}, "deterministic": {"$ref": "#/$defs/summary_arm"}, "jev": {"$ref": "#/$defs/summary_arm"}
    }},
    "jev_paired_effects": {"type": "object", "required": ["current", "deterministic"]},
    "resource_note": {"type": "string", "minLength": 1},
    "comparison_note": {"type": "string", "minLength": 1},
    "decision": {"enum": ["calibration_only_no_holdout_decision", "synthetic_gates_met_live_needs_more_evidence", "disable_for_fixture"]},
    "live_adoption": {"const": "not_authorized_no_real_history_or_provider"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arm": {"type": "object", "required": ["status", "backend_calls", "rollback_count", "committed", "assessment_count", "missing_latency_observations", "synthetic_cost_units", "synthetic_episode_latency_ms", "local_runner_wall_time_ms", "pin_loss", "byte_or_provenance_loss", "over_budget_commit", "wrong_mode_mutation", "retained_tokens", "recall", "later_task_success"], "properties": {
      "status": {"type": "string"}, "backend_calls": {"type": "integer", "minimum": 0},
      "rollback_count": {"type": "integer", "minimum": 0}, "committed": {"type": "boolean"},
      "assessment_count": {"type": "integer", "minimum": 0, "maximum": 12},
      "missing_latency_observations": {"type": "integer", "minimum": 0},
      "synthetic_cost_units": {"type": "number", "minimum": 0, "maximum": 0.036},
      "synthetic_episode_latency_ms": {"type": "number", "minimum": 0},
      "local_runner_wall_time_ms": {"type": "number", "minimum": 0},
      "pin_loss": {"type": "boolean"}, "byte_or_provenance_loss": {"type": "boolean"},
      "over_budget_commit": {"type": "boolean"}, "wrong_mode_mutation": {"type": "boolean"},
      "retained_tokens": {"type": "integer", "minimum": 0},
      "recall": {"type": "object", "required": ["applicable", "success", "missing", "citation_ids"]},
      "later_task_success": {"type": "boolean"}
    }},
    "summary_arm": {"type": "object", "required": ["efficacy_denominator", "safety_denominator", "later_task_success", "unresolved_contradiction_errors", "pin_loss", "byte_or_provenance_loss", "over_budget_commits", "wrong_mode_mutations", "assessment_calls", "missing_latency_observations", "synthetic_cost_units", "per_call_p50_ms", "per_call_p95_ms", "per_episode_p50_ms", "per_episode_p95_ms", "local_runner_wall_time_ms_total"], "properties": {
      "efficacy_denominator": {"type": "integer", "minimum": 0},
      "safety_denominator": {"type": "integer", "minimum": 0},
      "later_task_success": {"type": "integer", "minimum": 0},
      "unresolved_contradiction_errors": {"type": "integer", "minimum": 0},
      "pin_loss": {"type": "integer", "minimum": 0},
      "byte_or_provenance_loss": {"type": "integer", "minimum": 0},
      "over_budget_commits": {"type": "integer", "minimum": 0},
      "wrong_mode_mutations": {"type": "integer", "minimum": 0},
      "assessment_calls": {"type": "integer", "minimum": 0},
      "missing_latency_observations": {"type": "integer", "minimum": 0},
      "synthetic_cost_units": {"type": "number", "minimum": 0},
      "per_call_p50_ms": {"type": ["number", "null"], "minimum": 0},
      "per_call_p95_ms": {"type": ["number", "null"], "minimum": 0},
      "per_episode_p50_ms": {"type": ["number", "null"], "minimum": 0},
      "per_episode_p95_ms": {"type": ["number", "null"], "minimum": 0},
      "local_runner_wall_time_ms_total": {"type": "number", "minimum": 0}
    }}
  }
}
