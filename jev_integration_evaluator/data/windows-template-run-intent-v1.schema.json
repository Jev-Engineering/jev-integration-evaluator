{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "sequence", "action", "previous_selection_sha256", "session_path", "launch_environment", "install_plan_sha256", "install_receipt_sha256", "environment", "project_name", "project_version", "source_sha256", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "windows-template-run-intent-v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 2},
    "action": {"enum": ["initial", "upgrade", "rollback"]},
    "previous_selection_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "session_path": {"type": "string", "minLength": 1},
    "launch_environment": {"type": "object", "maxProperties": 16, "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "additionalProperties": {"type": "string", "maxLength": 4096}},
    "install_plan_sha256": {"$ref": "#/$defs/sha256"},
    "install_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "environment": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "project_version": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
