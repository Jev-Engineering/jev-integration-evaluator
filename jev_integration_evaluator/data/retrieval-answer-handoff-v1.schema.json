{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finite offline retrieval answer handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "query", "disposition", "answer", "passages", "missing_claim_ids", "missing_passage_ids", "missing_passages"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "retrieval-answer-handoff-v1"},
    "query": {"const": "approved"},
    "disposition": {"enum": ["released", "withheld_missing", "withheld_conflict"]},
    "answer": {"oneOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false,
       "required": ["text", "claim_id", "passage_ids"],
       "properties": {"text": {"const": "The reviewed source reports status approved."},
                      "claim_id": {"const": "status"},
                      "passage_ids": {"type": "array", "minItems": 1, "maxItems": 4,
                                      "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
    ]},
    "passages": {"type": "array", "maxItems": 32,
                 "items": {"$ref": "#/$defs/passage"}},
    "missing_claim_ids": {"type": "array", "maxItems": 1,
                          "uniqueItems": true, "items": {"const": "status"}},
    "missing_passage_ids": {"type": "array", "maxItems": 32,
                            "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "missing_passages": {"type": "array", "maxItems": 32,
                         "items": {"$ref": "#/$defs/passage"}}
  },
  "allOf": [
    {"if": {"properties": {"disposition": {"const": "released"}}},
     "then": {"properties": {"answer": {"type": "object"},
                              "missing_claim_ids": {"maxItems": 0},
                              "missing_passage_ids": {"maxItems": 0},
                              "missing_passages": {"maxItems": 0}}}},
    {"if": {"properties": {"disposition": {"enum": ["withheld_missing", "withheld_conflict"]}}},
     "then": {"properties": {"answer": {"type": "null"}}}},
    {"if": {"properties": {"disposition": {"const": "withheld_conflict"}}},
     "then": {"properties": {"passages": {"minItems": 1},
                              "missing_claim_ids": {"maxItems": 0},
                              "missing_passage_ids": {"maxItems": 0},
                              "missing_passages": {"maxItems": 0}}}}
  ],
  "$defs": {
    "passage": {"type": "object", "additionalProperties": false,
      "required": ["passage_id", "source_id", "span", "quote", "claim_id", "stance", "provenance", "initial_relevance"],
      "properties": {
        "passage_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "span": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "stance": {"enum": ["supports", "contradicts", "uncertain"]},
        "provenance": {"type": "string", "minLength": 1},
        "initial_relevance": {"enum": ["relevant", "irrelevant", "uncertain"]}
      }}
  }
}
