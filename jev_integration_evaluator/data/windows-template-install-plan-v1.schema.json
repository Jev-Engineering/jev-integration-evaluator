{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "package_plan", "package_receipt", "trusted_package_receipt_sha256", "operations", "runtime_activation_authorized", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "windows-template-install-plan-v1"},
    "package_plan": {"type": "object"},
    "package_receipt": {"type": "object"},
    "trusted_package_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "operations": {"const": ["create_private_venv", "install_hash_checked_wheels", "verify_installed_record_and_console", "write_off_configuration"]},
    "runtime_activation_authorized": {"const": false},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
