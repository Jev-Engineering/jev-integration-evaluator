{
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "review_context_sha256": [
      "review_context_sha256",
      "host_policy_sha256",
      "trusted_binding_review_sha256",
      "agent_proposal_sha256"
    ],
    "host_policy_sha256": [
      "review_context_sha256",
      "host_policy_sha256",
      "trusted_binding_review_sha256",
      "agent_proposal_sha256"
    ],
    "trusted_binding_review_sha256": [
      "review_context_sha256",
      "host_policy_sha256",
      "trusted_binding_review_sha256",
      "agent_proposal_sha256"
    ],
    "agent_proposal_sha256": [
