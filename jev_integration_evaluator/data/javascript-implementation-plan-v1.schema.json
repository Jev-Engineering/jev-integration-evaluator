{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned JavaScript implementation plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "root_sha256", "root_device", "root_inode", "spec_sha256", "patch_sha256", "spec_file_sha256", "patch_file_sha256", "preimage_sha256", "tooling", "format", "generated_sha256", "owned_files", "contract_digest"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "javascript-implementation-plan-v1"},
    "root_sha256": {"$ref": "#/$defs/hash"}, "root_device": {"type": "integer"},
    "root_inode": {"type": "integer"}, "spec_sha256": {"$ref": "#/$defs/hash"},
    "patch_sha256": {"$ref": "#/$defs/hash"}, "spec_file_sha256": {"$ref": "#/$defs/hash"},
    "patch_file_sha256": {"$ref": "#/$defs/hash"}, "preimage_sha256": {"$ref": "#/$defs/hash"},
    "tooling": {"type": "object", "required": ["node_path", "node_sha256", "compiler_path", "compiler_sha256", "compiler_version", "transformer_sha256", "runtime_sha256", "probe_sha256", "emitter_sha256", "backend_sha256", "lifecycle_sha256"], "additionalProperties": false,
      "properties": {"node_path": {"type": "string"}, "compiler_path": {"type": "string"},
        "compiler_version": {"const": "5.8.3"}, "node_sha256": {"$ref": "#/$defs/hash"},
        "compiler_sha256": {"$ref": "#/$defs/hash"}, "transformer_sha256": {"$ref": "#/$defs/hash"},
        "runtime_sha256": {"$ref": "#/$defs/hash"}, "probe_sha256": {"$ref": "#/$defs/hash"},
        "emitter_sha256": {"$ref": "#/$defs/hash"},
        "backend_sha256": {"$ref": "#/$defs/hash"},
        "lifecycle_sha256": {"$ref": "#/$defs/hash"}}},
    "format": {"enum": ["esm", "commonjs", "typescript"]},
    "generated_sha256": {"type": "object", "minProperties": 3, "maxProperties": 4,
      "additionalProperties": {"$ref": "#/$defs/hash"}},
    "owned_files": {"type": "array", "minItems": 3, "maxItems": 4,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["file", "old_sha256", "new_sha256", "old_mode"],
        "properties": {"file": {"type": "string"},
          "old_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
          "new_sha256": {"$ref": "#/$defs/hash"},
          "old_mode": {"oneOf": [{"type": "integer"}, {"type": "null"}]}}}},
    "contract_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
