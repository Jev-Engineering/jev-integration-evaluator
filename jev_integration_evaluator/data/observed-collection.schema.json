{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:observed-collection:1.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "offline_paired_collection"},
    "link_digest": {"$ref": "#/$defs/hash"},
    "study_digest": {"$ref": "#/$defs/hash"},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "fixture_sha256": {"$ref": "#/$defs/hash"},
    "labels_sha256": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["synthetic_complete", "incomplete_unknown_budget", "incomplete_bound_insufficient", "incomplete_scheduled_outcomes", "incomplete_egress_scope"]},
    "evidence_type": {"const": "synthetic"},
    "scheduled_pairs": {"type": "integer", "minimum": 1},
    "collected_pairs": {"type": "integer", "minimum": 0},
    "missing_pairs": {"type": "array", "items": {"type": "object", "properties": {
      "task_id": {"type": "string", "minLength": 1}, "replicate": {"type": "integer", "minimum": 0}
    }, "required": ["task_id", "replicate"], "additionalProperties": false}},
    "baseline": {"type": "array", "items": {"type": "object"}},
    "jev": {"type": "array", "items": {"type": "object"}},
    "host_adapter_calls": {"type": "integer", "minimum": 0},
    "recorded_cost": {"type": "number", "minimum": 0},
    "independent_label_count": {"type": "integer", "minimum": 0},
    "provider_connectivity": {"const": "not_tested"},
    "benefit_supported": {"const": false},
    "activation_eligible": {"const": false},
    "contract_digest": {"$ref": "#/$defs/hash"}
  },
  "required": ["schema_version", "kind", "link_digest", "study_digest", "request_sha256",
    "fixture_sha256", "labels_sha256", "status", "evidence_type", "scheduled_pairs",
    "collected_pairs", "missing_pairs", "baseline", "jev", "host_adapter_calls",
    "recorded_cost", "independent_label_count", "provider_connectivity",
    "benefit_supported", "activation_eligible", "contract_digest"],
  "additionalProperties": false,
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
