{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact host-authenticated stopped connected generation transfer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "action", "old_identity", "new_identity", "old_plan_sha256", "new_plan_sha256", "old_binding_sha256", "new_binding_sha256", "session_head_sha256", "history_sha256", "limits", "old_placements", "new_to_old_placements", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "connected-generation-transfer-v1"},
    "action": {"enum": ["upgrade", "rollback"]},
    "old_identity": {"$ref": "#/$defs/sha"},
    "new_identity": {"$ref": "#/$defs/sha"},
    "old_plan_sha256": {"$ref": "#/$defs/sha"},
    "new_plan_sha256": {"$ref": "#/$defs/sha"},
    "old_binding_sha256": {"$ref": "#/$defs/sha"},
    "new_binding_sha256": {"$ref": "#/$defs/sha"},
    "session_head_sha256": {"$ref": "#/$defs/sha"},
    "history_sha256": {"$ref": "#/$defs/sha"},
    "issued_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "old_placements": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "new_to_old_placements": {"type": "object", "minProperties": 1, "maxProperties": 4, "propertyNames": {"minLength": 1}, "additionalProperties": {"type": "string", "minLength": 1}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_calls_per_task", "max_cost_per_task", "max_total_calls", "max_total_cost", "max_in_flight", "max_tasks"],
      "properties": {
        "max_calls_per_task": {"type": "integer", "minimum": 1},
        "max_cost_per_task": {"type": "number", "minimum": 0},
        "max_total_calls": {"type": "integer", "minimum": 1},
        "max_total_cost": {"type": "number", "minimum": 0},
        "max_in_flight": {"type": "integer", "minimum": 1},
        "max_tasks": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
