{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jev-integration-evaluator:repository-placement-review-v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract": {
      "const": "repository-placement-review-v1"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^JEV-[A-Z0-9-]+$",
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "approved": {
      "type": "boolean"
    },
    "mode": {
      "const": "experimental"
    },
    "resource_bounds": {
      "type": "object",
      "properties": {
        "max_calls_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "max_cost_total_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 604800
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "max_calls_total",
        "max_cost_total_usd",
        "deadline_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "contract",
    "context_sha256",
    "candidate_ids",
    "reviewer",
    "reason",
    "approved",
    "mode",
    "resource_bounds"
  ],
  "additionalProperties": false
}
