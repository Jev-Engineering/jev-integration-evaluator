{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "prerequisite-validation-v1"},
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "entry", "entry_sha256", "entry_mode", "observation"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "entry": {"type": "string", "minLength": 1, "maxLength": 256},
          "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "entry_mode": {"type": "integer", "minimum": 0, "maximum": 4095},
          "observation": {"type": "object"}
        }
      }
    }
  }
}
