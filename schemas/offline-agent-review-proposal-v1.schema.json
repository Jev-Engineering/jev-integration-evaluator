{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:offline-agent-review-proposal-v1:1.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "offline-agent-review-proposal-v1"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 2000},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "file": {"type": "string", "minLength": 1, "maxLength": 1024},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "symbol": {"type": "string", "maxLength": 256}
        },
        "required": ["file", "sha256", "symbol"], "additionalProperties": false
      }
    },
    "recipe_id": {"type": "string", "pattern": "^python\\.[A-M]$"},
    "bindings": {"type": "object", "maxProperties": 32,
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"}},
    "questions": {"type": "object", "minProperties": 1, "maxProperties": 255},
    "primary_question": {"type": "string", "minLength": 1, "maxLength": 256},
    "evidence_question": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 256}, {"type": "null"}]},
    "label_actions": {"type": "object", "minProperties": 1, "maxProperties": 255,
      "additionalProperties": {"anyOf": [{"type": "string"}, {"type": "null"}]}},
    "unresolved": {"type": "array", "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true}
  },
  "required": ["schema_version", "kind", "request_sha256", "reviewer", "reason", "evidence",
    "recipe_id", "bindings", "questions", "primary_question", "evidence_question",
    "label_actions", "unresolved"],
  "additionalProperties": false
}
