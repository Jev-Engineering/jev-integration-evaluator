{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only durable connected ledger generation transfer status",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "status", "receipt", "grant_sha256", "current_identity", "current_history_sha256", "current_generation_grant_sha256"],
  "properties": {
    "kind": {"const": "connected-generation-transfer-status-v1"},
    "status": {"enum": ["not_transferred", "history_changed", "committed"]},
    "receipt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/receipt"}]},
    "grant_sha256": {"$ref": "#/$defs/sha"},
    "current_identity": {"$ref": "#/$defs/sha"},
    "current_history_sha256": {"$ref": "#/$defs/sha"},
    "current_generation_grant_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "receipt": {"type": "object", "additionalProperties": false,
      "required": ["kind", "grant_sha256", "before_sha256", "after_sha256", "sequence"],
      "properties": {
        "kind": {"const": "connected-generation-transfer-receipt-v1"},
        "grant_sha256": {"$ref": "#/$defs/sha"},
        "before_sha256": {"$ref": "#/$defs/sha"},
        "after_sha256": {"$ref": "#/$defs/sha"},
        "sequence": {"type": "integer", "minimum": 1}
      }}
  }
}
