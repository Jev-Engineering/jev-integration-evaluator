{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://completetech.invalid/jev/holdout-report.schema.json",
  "title": "Holdout validation report 1.1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "contract_digest",
    "policy_digest",
    "binding",
    "holdout_digest",
    "scheduled_observations",
    "method",
    "familywise_alpha",
    "maximum_error",
    "minimum_accepted",
    "acceptance_policy",
    "checks",
    "numerical_checks_pass",
    "eligible_for_activation",
    "deployment_authorized",
    "status",
    "externally_pinned_digest",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "kind": {
      "const": "holdout_validation"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "rubric_hash": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "enum": [
            "synthetic",
            "observed"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "model_id",
        "policy_version",
        "rubric_hash",
        "evidence_type",
        "labels"
      ],
      "additionalProperties": false
    },
    "holdout_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scheduled_observations": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "type": "string"
    },
    "familywise_alpha": {
      "type": "number",
      "minimum": 1e-10,
      "maximum": 0.5
    },
    "maximum_error": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "minimum_accepted": {
      "type": "integer",
      "minimum": 1
    },
    "acceptance_policy": {
      "type": "object",
      "properties": {
        "probability_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "action_probability_floors": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "abstention_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "probability_floor",
        "confidence_floor",
        "action_probability_floors",
        "abstention_labels"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subgroup",
          "observations",
          "accepted",
          "errors",
          "coverage",
          "empirical_error",
          "error_upper_bound",
          "alpha",
          "passes",
          "status"
        ],
        "properties": {
          "subgroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "observations": {
            "type": "integer",
            "minimum": 0
          },
          "accepted": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "coverage": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "empirical_error": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "error_upper_bound": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "alpha": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "passes": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "evaluated",
              "insufficient_independent_accepted_observations"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "numerical_checks_pass": {
      "type": "boolean"
    },
    "eligible_for_activation": {
      "type": "boolean"
    },
    "deployment_authorized": {
      "const": false
    },
    "status": {
      "enum": [
        "validated",
        "synthetic_only",
        "needs_more_evidence_or_lower_risk"
      ]
    },
    "externally_pinned_digest": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
