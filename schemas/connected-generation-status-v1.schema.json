{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only connected installed child cutover status",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "run_id", "grant_sha256", "ledger", "child_stage", "child_head_sha256"],
  "properties": {
    "kind": {"const": "connected-generation-status-v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "grant_sha256": {"$ref": "#/$defs/sha"},
    "ledger": {"$ref": "#/$defs/ledger"},
    "child_stage": {"enum": ["generation_pending", "installed", "launch_pending", "launched", "running", "stop_pending", "blocked_recovery", "stopped"]},
    "child_head_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ledger": {"type": "object", "additionalProperties": false,
      "required": ["kind", "status", "receipt", "grant_sha256", "current_identity", "current_history_sha256", "current_generation_grant_sha256"],
      "properties": {
        "kind": {"const": "connected-generation-transfer-status-v1"},
        "status": {"enum": ["not_transferred", "history_changed", "committed"]},
        "receipt": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
          "required": ["kind", "grant_sha256", "before_sha256", "after_sha256", "sequence"],
          "properties": {
            "kind": {"const": "connected-generation-transfer-receipt-v1"},
            "grant_sha256": {"$ref": "#/$defs/sha"},
            "before_sha256": {"$ref": "#/$defs/sha"},
            "after_sha256": {"$ref": "#/$defs/sha"},
            "sequence": {"type": "integer", "minimum": 1}}}]},
        "grant_sha256": {"$ref": "#/$defs/sha"},
        "current_identity": {"$ref": "#/$defs/sha"},
        "current_history_sha256": {"$ref": "#/$defs/sha"},
        "current_generation_grant_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}
      }}
  }
}
