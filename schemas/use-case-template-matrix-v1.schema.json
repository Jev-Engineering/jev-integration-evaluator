{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only use-case template coverage matrix v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scope", "host", "independent_host_checkpoints", "rows"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scope": {"const": "offline_source_contracts_and_partial_l_d_e_m_h_installed"},
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["console", "console_sha256", "project", "project_sha256"],
      "properties": {
        "console": {"const": "examples/use-case-host/console.py"},
        "console_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "project": {"const": "examples/use-case-host/pyproject.toml"},
        "project_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "independent_host_checkpoints": {"type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"type": "object", "additionalProperties": false,
          "required": ["kind", "root", "host_sha256", "console_sha256", "loader_sha256", "project_sha256", "installed_execution", "provider", "canary", "active", "benefit", "separate_from_use_case_c"],
          "properties": {
            "kind": {"const": "registered-alpha-connected-shadow-v1"},
            "root": {"const": "tests/independent_hosts/registered_alpha_connected"},
            "host_sha256": {"$ref": "#/$defs/sha"},
            "console_sha256": {"$ref": "#/$defs/sha"},
            "loader_sha256": {"$ref": "#/$defs/sha"},
            "project_sha256": {"$ref": "#/$defs/sha"},
            "installed_execution": {"const": "qualified_offline_connected_shadow_startup_protocol"},
            "provider": {"const": "unobserved"},
            "canary": {"const": "pending_observed_gate"},
            "active": {"const": "pending_observed_gate"},
            "benefit": {"const": "unknown"},
            "separate_from_use_case_c": {"const": true}}},
        {"type": "object", "additionalProperties": false,
          "required": ["kind", "root", "placements", "console_sha256", "loader_sha256", "project_sha256", "installed_execution", "provider", "canary", "active", "upgrade", "rollback", "benefit", "separate_from_use_case_c"],
          "properties": {
            "kind": {"const": "registered-dual-connected-shadow-v1"},
            "root": {"const": "tests/independent_hosts/registered_dual_connected"},
            "placements": {"type": "object", "additionalProperties": false,
              "required": ["JEV-DA938C3C7965", "JEV-EDF19BDB65F0"],
              "properties": {
                "JEV-DA938C3C7965": {"$ref": "#/$defs/dual_queue"},
                "JEV-EDF19BDB65F0": {"$ref": "#/$defs/dual_alpha"}}},
            "console_sha256": {"$ref": "#/$defs/sha"},
            "loader_sha256": {"$ref": "#/$defs/sha"},
            "project_sha256": {"$ref": "#/$defs/sha"},
            "installed_execution": {"const": "qualified_offline_connected_dual_shadow_protocol"},
            "provider": {"const": "unobserved"},
            "canary": {"const": "pending_combined_observed_gate"},
            "active": {"const": "pending_combined_observed_gate"},
            "upgrade": {"const": "pending_connected_upgrade"},
            "rollback": {"const": "pending_connected_rollback"},
            "benefit": {"const": "unknown"},
            "separate_from_use_case_c": {"const": true}}}
,
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "root",
            "host_sha256",
            "console_sha256",
            "loader_sha256",
            "project_sha256",
            "installed_execution",
            "provider",
            "canary",
            "active",
            "benefit",
            "separate_from_use_case_c"
          ],
          "properties": {
            "kind": {
              "const": "registered-alpha-connected-windows-shadow-v1"
            },
            "root": {
              "const": "tests/independent_hosts/registered_alpha_connected_windows"
            },
            "host_sha256": {
              "$ref": "#/$defs/sha"
            },
            "console_sha256": {
              "$ref": "#/$defs/sha"
            },
            "loader_sha256": {
              "$ref": "#/$defs/sha"
            },
            "project_sha256": {
              "$ref": "#/$defs/sha"
            },
            "installed_execution": {
              "const": "pending_native_windows_connected_shadow_qualification"
            },
            "provider": {
              "const": "unobserved"
            },
            "canary": {
              "const": "pending_observed_gate"
            },
            "active": {
              "const": "pending_observed_gate"
            },
            "benefit": {
              "const": "unknown"
            },
            "separate_from_use_case_c": {
              "const": true
            }
          }
        }
      ]},
    "rows": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dual_queue": {"type": "object", "additionalProperties": false,
      "required": ["file", "sha256"], "properties": {
        "file": {"const": "src/registered_dual/work_queue.py"},
        "sha256": {"$ref": "#/$defs/sha"}}},
    "dual_alpha": {"type": "object", "additionalProperties": false,
      "required": ["file", "sha256"], "properties": {
        "file": {"const": "src/registered_dual/alpha.py"},
        "sha256": {"$ref": "#/$defs/sha"}}},
    "row": {
      "type": "object", "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"id": {"enum": ["L", "D", "E", "M", "H"]}}},
         "then": {"required": ["consumer_adapter", "consumer_adapter_sha256"]},
         "else": {"properties": {
           "installed_execution": {"pattern": "^pending_"},
           "apply": {"const": "pending"}, "install": {"const": "pending"},
           "launch": {"const": "pending"}, "materialize": {"const": "pending"},
           "bind": {"const": "pending"}, "verify": {"const": "pending"},
           "status": {"const": "pending"}, "disable": {"const": "pending"},
           "upgrade": {"const": "pending"}, "rollback": {"const": "pending"}}}},
        {"if": {"properties": {"id": {"const": "L"}}},
         "then": {"properties": {
           "consumer_adapter": {"const": "examples/use-case-host/graph_runtime.py"},
           "installed_execution": {"const": "qualified_offline_l_synthetic_host"},
           "bind": {"const": "qualified_offline_l_synthetic_host"},
           "apply": {"const": "qualified_offline_l_synthetic_host"},
           "install": {"const": "qualified_offline_l_synthetic_host"},
           "launch": {"const": "qualified_offline_l_synthetic_host"},
           "materialize": {"const": "qualified_offline_l_synthetic_host"},
           "verify": {"const": "qualified_offline_l_synthetic_host"},
           "status": {"const": "qualified_offline_l_synthetic_host"},
           "disable": {"const": "qualified_offline_l_synthetic_host"},
           "upgrade": {"const": "qualified_offline_l_synthetic_host"},
           "rollback": {"const": "qualified_offline_l_synthetic_host"}}}},
        {"if": {"properties": {"id": {"const": "D"}}},
         "then": {"required": ["consumer_corpus", "consumer_corpus_sha256", "connected_shadow", "connected_upgrade"],
           "properties": {
           "consumer_adapter": {"const": "examples/use-case-host/retrieval_consumer.py"},
           "consumer_corpus": {"const": "examples/use-case-host/retrieval_corpus_v1.json"},
           "connected_shadow": {"const": "qualified_offline_d_installed_shadow_protocol"},
           "connected_upgrade": {"const": "pending"},
           "installed_execution": {"const": "qualified_offline_d_synthetic_host"},
           "bind": {"const": "qualified_offline_d_synthetic_host"},
           "apply": {"const": "qualified_offline_d_synthetic_host"},
           "install": {"const": "qualified_offline_d_synthetic_host"},
           "launch": {"const": "qualified_offline_d_synthetic_host"},
           "materialize": {"const": "qualified_offline_d_synthetic_host"},
           "verify": {"const": "qualified_offline_d_synthetic_host"},
           "status": {"const": "qualified_offline_d_synthetic_host"},
           "disable": {"const": "qualified_offline_d_synthetic_host"},
           "upgrade": {"const": "qualified_offline_d_synthetic_host"},
           "rollback": {"const": "qualified_offline_d_synthetic_host"}}}},
        {"if": {"properties": {"id": {"const": "E"}}},
         "then": {"properties": {
           "consumer_adapter": {"const": "examples/use-case-host/completion_consumer.py"},
           "installed_execution": {"const": "qualified_offline_e_synthetic_host"},
           "bind": {"enum": ["pending_e_console_binding", "qualified_offline_e_synthetic_host"]},
           "apply": {"const": "qualified_offline_e_synthetic_host"},
           "install": {"const": "qualified_offline_e_synthetic_host"},
           "launch": {"const": "qualified_offline_e_synthetic_host"},
           "materialize": {"const": "qualified_offline_e_synthetic_host"},
           "verify": {"const": "qualified_offline_e_synthetic_host"},
           "status": {"const": "qualified_offline_e_synthetic_host"},
           "disable": {"const": "qualified_offline_e_synthetic_host"},
           "upgrade": {"const": "qualified_offline_e_synthetic_host"},
           "rollback": {"const": "qualified_offline_e_synthetic_host"}}}},
        {"if": {"properties": {"id": {"const": "M"}}},
         "then": {"properties": {
           "consumer_adapter": {"const": "examples/use-case-host/claim_consumer.py"},
           "installed_execution": {"const": "qualified_offline_m_synthetic_host"},
           "bind": {"const": "qualified_offline_m_synthetic_host"},
           "apply": {"const": "qualified_offline_m_synthetic_host"},
           "install": {"const": "qualified_offline_m_synthetic_host"},
           "launch": {"const": "qualified_offline_m_synthetic_host"},
           "materialize": {"const": "qualified_offline_m_synthetic_host"},
           "verify": {"const": "qualified_offline_m_synthetic_host"},
           "status": {"const": "qualified_offline_m_synthetic_host"},
           "disable": {"const": "qualified_offline_m_synthetic_host"},
           "upgrade": {"const": "qualified_offline_m_synthetic_host"},
           "rollback": {"const": "qualified_offline_m_synthetic_host"}}}},
        {"if": {"properties": {"id": {"const": "H"}}},
         "then": {"required": ["connected_shadow", "connected_upgrade"], "properties": {
           "connected_shadow": {"const": "pending"},
           "connected_upgrade": {"const": "pending"},
           "consumer_adapter": {"const": "examples/use-case-host/retention_consumer.py"},
           "installed_execution": {"const": "qualified_offline_h_synthetic_host"},
           "bind": {"enum": ["pending_h_console_binding", "qualified_offline_h_synthetic_host"]},
           "apply": {"const": "qualified_offline_h_synthetic_host"},
           "install": {"const": "qualified_offline_h_synthetic_host"},
           "launch": {"const": "qualified_offline_h_synthetic_host"},
           "materialize": {"const": "qualified_offline_h_synthetic_host"},
           "verify": {"const": "qualified_offline_h_synthetic_host"},
           "status": {"const": "qualified_offline_h_synthetic_host"},
           "disable": {"const": "qualified_offline_h_synthetic_host"},
           "upgrade": {"const": "qualified_offline_h_synthetic_host"},
           "rollback": {"const": "qualified_offline_h_synthetic_host"}}}}
      ],
      "required": ["id", "contract_id", "use_case", "issue", "template_id", "template_version", "recipe", "backend", "shape", "platform", "source", "source_sha256", "host_consumer", "host_oracle", "offline_contract", "installed_execution", "materialize", "bind", "apply", "install", "launch", "verify", "status", "disable", "upgrade", "rollback", "provider", "mode", "benefit"],
      "properties": {
        "id": {"enum": ["C", "L", "D", "E", "M", "H"]},
        "contract_id": {"type": "string", "pattern": "^use-case\\.[CDEHLM]@1\\.0\\.0$"},
        "use_case": {"type": "string", "minLength": 1}, "issue": {"type": "integer", "minimum": 1},
        "template_id": {"const": "python.bounded-tail-call"}, "template_version": {"const": "1.0.0"},
        "recipe": {"type": "string", "pattern": "^python\\.[CDEHLM]@1\\.0$"},
        "backend": {"const": "python"}, "shape": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "source": {"type": "string", "pattern": "^examples/[a-z-]+/[a-z_]+\\.py$"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "consumer_adapter": {"enum": ["examples/use-case-host/graph_runtime.py", "examples/use-case-host/retrieval_consumer.py", "examples/use-case-host/completion_consumer.py", "examples/use-case-host/claim_consumer.py", "examples/use-case-host/retention_consumer.py"]},
        "consumer_adapter_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "consumer_corpus": {"const": "examples/use-case-host/retrieval_corpus_v1.json"},
        "consumer_corpus_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "connected_shadow": {"enum": ["qualified_offline_d_installed_shadow_protocol", "pending"]},
        "connected_upgrade": {"const": "pending"},
        "host_consumer": {"type": "string", "minLength": 1}, "host_oracle": {"type": "string", "minLength": 1},
        "offline_contract": {"enum": ["source_review_required", "tested_fixture"]},
        "installed_execution": {"type": "string", "pattern": "^(pending_|qualified_offline_[ldemh]_synthetic_host$)"},
        "apply": {"enum": ["pending", "qualified_offline_l_synthetic_host", "qualified_offline_d_synthetic_host", "qualified_offline_e_synthetic_host", "qualified_offline_m_synthetic_host", "qualified_offline_h_synthetic_host"]},
        "install": {"enum": ["pending", "qualified_offline_l_synthetic_host", "qualified_offline_d_synthetic_host", "qualified_offline_e_synthetic_host", "qualified_offline_m_synthetic_host", "qualified_offline_h_synthetic_host"]},
        "launch": {"enum": ["pending", "qualified_offline_l_synthetic_host", "qualified_offline_d_synthetic_host", "qualified_offline_e_synthetic_host", "qualified_offline_m_synthetic_host", "qualified_offline_h_synthetic_host"]},
        "materialize": {"enum": ["pending", "qualified_offline_l_synthetic_host", "qualified_offline_d_synthetic_host", "qualified_offline_e_synthetic_host", "qualified_offline_m_synthetic_host", "qualified_offline_h_synthetic_host"]},
        "bind": {"enum": ["pending", "pending_l_console_binding", "qualified_offline_l_synthetic_host", "pending_d_console_binding", "qualified_offline_d_synthetic_host", "pending_e_console_binding", "qualified_offline_e_synthetic_host", "pending_m_console_binding", "qualified_offline_m_synthetic_host", "pending_h_console_binding", "qualified_offline_h_synthetic_host"]},
        "verify": {"enum": ["pending", "qualified_offline_l_synthetic_host", "qualified_offline_d_synthetic_host", "qualified_offline_e_synthetic_host", "qualified_offline_m_synthetic_host", "qualified_offline_h_synthetic_host"]},
        "status": {"enum": ["pending", "qualified_offline_l_synthetic_host", "qualified_offline_d_synthetic_host", "qualified_offline_e_synthetic_host", "qualified_offline_m_synthetic_host", "qualified_offline_h_synthetic_host"]},
        "disable": {"enum": ["pending", "qualified_offline_l_synthetic_host", "qualified_offline_d_synthetic_host", "qualified_offline_e_synthetic_host", "qualified_offline_m_synthetic_host", "qualified_offline_h_synthetic_host"]},
        "upgrade": {"enum": ["pending", "qualified_offline_l_synthetic_host", "qualified_offline_d_synthetic_host", "qualified_offline_e_synthetic_host", "qualified_offline_m_synthetic_host", "qualified_offline_h_synthetic_host"]},
        "rollback": {"enum": ["pending", "qualified_offline_l_synthetic_host", "qualified_offline_d_synthetic_host", "qualified_offline_e_synthetic_host", "qualified_offline_m_synthetic_host", "qualified_offline_h_synthetic_host"]},
        "provider": {"const": "pending"}, "mode": {"const": "off"}, "benefit": {"const": "unknown"}
      }
    }
  }
}
