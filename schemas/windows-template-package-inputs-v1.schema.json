{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "profile", "source_files", "source_traversal_exclusions", "source_sha256", "wheel_files", "wheels_sha256", "console_script", "project_name", "project_version", "build_requirements", "entry_point", "interpreter", "interpreter_sha256", "target_modified", "target_executed", "build_authorized", "install_authorized", "launch_authorized", "output_private_creation", "execution_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "package_inputs_reviewed_only"},
    "profile": {"type": "object", "additionalProperties": false, "required": ["os", "build", "architecture", "python", "filesystem"], "properties": {"os": {"enum": ["windows_11", "windows_server_2022"]}, "build": {"type": "integer", "minimum": 20348}, "architecture": {"const": "x86_64"}, "python": {"type": "string", "pattern": "^3\\.(10|13|14)\\.[0-9]+$"}, "filesystem": {"const": "local_ntfs"}}},
    "source_files": {"type": "object", "minProperties": 1, "maxProperties": 4096, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "source_traversal_exclusions": {"const": [".git", ".pytest_cache", "__pycache__", "build", "dist"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wheel_files": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["filename", "sha256", "name", "version"], "properties": {"filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*\\.whl$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}},
    "wheels_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "console_script": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "project_name": {"type": "string", "minLength": 1},
    "project_version": {"type": "string", "minLength": 1},
    "build_requirements": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^(setuptools|wheel)==[A-Za-z0-9][A-Za-z0-9._+!-]*$"}},
    "entry_point": {"type": "string", "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*$"},
    "interpreter": {"type": "string", "minLength": 1},
    "interpreter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_modified": {"const": false},
    "target_executed": {"const": false},
    "build_authorized": {"const": false},
    "install_authorized": {"const": false},
    "launch_authorized": {"const": false},
    "output_private_creation": {"const": "pending"},
    "execution_boundary": {"const": "trusted_local_host_no_isolation"}
  }
}
