{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "template_version", "backend", "backend_version", "evaluator_version", "runtime_model", "recipe_versions", "language", "source_grammar", "host_interfaces", "entrypoint_profile", "supported_targets", "dependency_format", "configuration_format", "secret_references", "runtime_ownership", "legal_decisions", "fallback", "evidence_schema", "verification_schedule", "lifecycle", "parameter_schema", "planner", "renderer"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "template_id": {"const": "python.bounded-tail-call"},
    "template_version": {"const": "1.0.0"},
    "backend": {"const": "python"},
    "backend_version": {"const": "1.0"},
    "evaluator_version": {"const": "1.3.0.dev12"},
    "runtime_model": {"const": "jev-1.13.0"},
    "recipe_versions": {"type": "object", "minProperties": 13, "maxProperties": 13, "patternProperties": {"^python\\.[A-M]$": {"const": "1.0"}}, "additionalProperties": false},
    "language": {"const": "python"},
    "source_grammar": {"const": "module-tail-call-v1"},
    "host_interfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "entrypoint_profile": {"type": "string", "minLength": 1},
    "supported_targets": {"type": "object", "additionalProperties": false, "required": ["os", "python", "deployment", "qualification"], "properties": {"os": {"type": "array", "items": {"enum": ["linux", "windows-local-ntfs"]}, "uniqueItems": true}, "python": {"const": ">=3.10"}, "deployment": {"type": "array", "items": {"type": "string"}}, "qualification": {"type": "string", "minLength": 1}}},
    "dependency_format": {"type": "string", "minLength": 1},
    "configuration_format": {"type": "string", "minLength": 1},
    "secret_references": {"type": "string", "minLength": 1},
    "runtime_ownership": {"type": "string", "minLength": 1},
    "legal_decisions": {"type": "string", "minLength": 1},
    "fallback": {"type": "string", "minLength": 1},
    "evidence_schema": {"const": "implementation-observation"},
    "verification_schedule": {"type": "string", "minLength": 1},
    "lifecycle": {"type": "object", "additionalProperties": false,
      "required": ["selection", "parameter_validation", "generation", "materialization", "binding_adaptation", "planning", "baseline", "apply", "build", "install", "configure", "launch", "entrypoint_reachability", "connectivity", "verification", "status", "disable", "stop", "upgrade", "rollback", "authorized_mode", "shadow_mode", "canary_mode", "active_mode", "measured_benefit"],
      "properties": {
        "selection": {"const": "requires_current_review"},
        "parameter_validation": {"const": "supported"},
        "generation": {"const": "supported"},
        "materialization": {"const": "supported"},
        "binding_adaptation": {"enum": ["requires_existing_planner", "supported_bounded_python_C_console"]},
        "planning": {"const": "requires_existing_planner"},
        "baseline": {"const": "pending_separate_execution_authority"},
        "apply": {"const": "pending_separate_approval"},
        "build": {"const": "unsupported_by_renderer"},
        "install": {"const": "unsupported_by_renderer"},
        "configure": {"const": "unsupported_by_renderer"},
        "launch": {"const": "unsupported_by_renderer"},
        "entrypoint_reachability": {"const": "pending_host_test"},
        "connectivity": {"const": "pending_separate_authority"},
        "verification": {"const": "pending_authorized_host_test"},
        "status": {"const": "render_status_only"},
        "disable": {"const": "host_control_required"},
        "stop": {"const": "host_control_required"},
        "upgrade": {"const": "fresh_request_required"},
        "rollback": {"const": "target_rollback_requires_existing_lifecycle"},
        "authorized_mode": {"const": "off"},
        "shadow_mode": {"const": "pending_separate_authority"},
        "canary_mode": {"const": "pending_separate_authority"},
        "active_mode": {"const": "pending_separate_authority"},
        "measured_benefit": {"const": "unknown"}
      }
    },
    "parameter_schema": {"const": "template-request-v1"},
    "planner": {"const": "implement-plan"},
    "renderer": {"const": "template-renderer-v1"}
  }
}
