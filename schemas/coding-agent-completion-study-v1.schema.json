{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:coding-agent-completion-study:1",
  "type": "object",
  "required": ["schema_version", "status", "candidate", "source_base_commit", "assignment_seed", "splits", "frozen_input_sha256", "rubric_version", "policy_version"],
  "properties": {
    "schema_version": {"const": "coding-agent-completion-study-v1"},
    "status": {"enum": ["prepared_pending_independent_review", "independently_reviewed"]},
    "candidate": {"const": "JEV-CA6A0A259F69"},
    "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "assignment_seed": {"const": 460149},
    "splits": {"type": "object", "required": ["calibration", "holdout"], "properties": {
      "calibration": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^c[0-9]{2}$"}},
      "holdout": {"type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^h[0-9]{2}$"}}
    }, "additionalProperties": false},
    "frozen_input_sha256": {"type": "object", "required": ["source", "runner", "oracle", "cases", "scorer", "assessments", "policy", "report_schema"], "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "rubric_version": {"const": "completion-choice-v1"},
    "policy_version": {"const": "completion-host-observation-v1"}
  },
  "additionalProperties": true
}
