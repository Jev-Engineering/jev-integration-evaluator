{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "off_provenance", "installed_binding", "trusted_binding_sha256", "trusted_package_receipt_sha256", "reference_sha256", "requested_mode", "provider_reachable", "runtime_activation_authorized", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "connected-delivery-plan-v1"},
    "off_provenance": {"type": "object"},
    "installed_binding": {"type": "object"},
    "trusted_binding_sha256": {"$ref": "#/$defs/sha"},
    "trusted_package_receipt_sha256": {"$ref": "#/$defs/sha"},
    "reference_sha256": {"type": "object", "additionalProperties": false,
      "required": ["REGISTERED_ALPHA_CONNECTED_REF", "REGISTERED_ALPHA_AUTH_PUBKEY_FILE"],
      "properties": {"REGISTERED_ALPHA_CONNECTED_REF": {"$ref": "#/$defs/sha"},
                     "REGISTERED_ALPHA_AUTH_PUBKEY_FILE": {"$ref": "#/$defs/sha"},
                     "SSL_CERT_FILE": {"$ref": "#/$defs/sha"}}},
    "requested_mode": {"const": "shadow"},
    "provider_reachable": {"type": "null"},
    "runtime_activation_authorized": {"const": false},
    "plan_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
