{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only offline Node delivery status v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "descriptor_sha256", "generation_id", "stage", "pending", "disabled", "process_alive", "observations", "attempts", "failures", "session_head_sha256", "previous_generation_rollback_digest"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "node-delivery-status-v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "descriptor_sha256": {"$ref": "#/$defs/sha"},
    "generation_id": {"$ref": "#/$defs/sha"},
    "stage": {"enum": ["created", "launch_pending", "running", "stop_pending", "stopped", "disabled", "upgrade_pending", "upgrade_staged", "rollback_pending", "rolled_back", "blocked_recovery"]},
    "pending": {"enum": [null, "launch", "stop", "disable", "upgrade", "rollback"]},
    "disabled": {"type": "boolean"}, "process_alive": {"type": "boolean"},
    "observations": {"type": "object", "additionalProperties": false,
      "required": ["launched", "ready", "entrypoint_reached", "integration_reachable", "outcome_verified"],
      "properties": {"launched": {"type": "boolean"}, "ready": {"type": "boolean"},
        "entrypoint_reached": {"type": "boolean"}, "integration_reachable": {"type": "boolean"},
        "outcome_verified": {"type": "boolean"}}},
    "attempts": {"type": "object", "additionalProperties": false,
      "required": ["launch", "stop"], "properties": {
        "launch": {"type": "integer", "minimum": 0, "maximum": 3},
        "stop": {"type": "integer", "minimum": 0, "maximum": 32}}},
    "failures": {"type": "array", "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "session_head_sha256": {"$ref": "#/$defs/sha"},
    "previous_generation_rollback_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "current_installation": {"enum": ["current_verified", "drift_or_unavailable"]}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
