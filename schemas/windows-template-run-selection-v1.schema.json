{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "sequence", "action", "generation_sha256", "previous_selection_sha256", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "windows-template-run-selection-v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 2},
    "action": {"enum": ["initial", "upgrade", "rollback"]},
    "generation_sha256": {"$ref": "#/$defs/sha256"},
    "previous_selection_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
