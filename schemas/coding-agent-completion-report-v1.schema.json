{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completetech:jev:coding-agent-completion-report:1",
  "type": "object",
  "required": ["schema_version", "kind", "split", "input_sha256", "study_spec_sha256", "candidate", "arm_order_counts", "rows", "summary", "local_fixture_wall_time_ms", "decision", "live_adoption"],
  "properties": {
    "schema_version": {"const": "coding-agent-completion-report-v1"},
    "kind": {"const": "offline_synthetic_fixture"},
    "split": {"enum": ["calibration", "holdout"]},
    "input_sha256": {"type": "object", "required": ["source", "runner", "oracle", "cases", "scorer", "assessments", "policy", "report_schema"], "additionalProperties": {"$ref": "#/$defs/hash"}},
    "study_spec_sha256": {"$ref": "#/$defs/hash"},
    "candidate": {"const": "JEV-CA6A0A259F69"},
    "arm_order_counts": {"type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": {"type": "integer", "minimum": 0}},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "category", "arm_order", "arms"], "properties": {
      "id": {"type": "string", "minLength": 3},
      "category": {"type": "string"},
      "arm_order": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["current", "deterministic", "jev"]}},
      "arms": {"type": "object", "required": ["current", "deterministic", "jev"], "properties": {
        "current": {"$ref": "#/$defs/arm"}, "deterministic": {"$ref": "#/$defs/arm"}, "jev": {"$ref": "#/$defs/arm"}
      }, "additionalProperties": false}
    }, "additionalProperties": false}},
    "summary": {"type": "object", "required": ["current", "deterministic", "jev"], "properties": {
      "current": {"$ref": "#/$defs/summary_arm"}, "deterministic": {"$ref": "#/$defs/summary_arm"}, "jev": {"$ref": "#/$defs/summary_arm"}
    }, "additionalProperties": false},
    "local_fixture_wall_time_ms": {"type": "number", "minimum": 0},
    "decision": {"enum": ["calibration_only_no_holdout_decision", "synthetic_thresholds_met_live_needs_more_evidence", "disable_for_fixture"]},
    "live_adoption": {"const": "needs_more_evidence_no_live_model_or_host_execution"}
  },
  "additionalProperties": true,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary_arm": {"type": "object", "required": ["synthetic_p50_latency_ms", "synthetic_p95_latency_ms", "missing_latency_observations", "local_runner_wall_time_ms_total"], "properties": {
      "synthetic_p50_latency_ms": {"type": ["number", "null"], "minimum": 0},
      "synthetic_p95_latency_ms": {"type": ["number", "null"], "minimum": 0},
      "missing_latency_observations": {"type": "integer", "minimum": 0},
      "local_runner_wall_time_ms_total": {"type": "number", "minimum": 0}
    }, "additionalProperties": true},
    "arm": {"type": "object", "required": ["verified_completion", "false_completion", "stop_reason", "attempted_actions", "assessment_count", "receipt_statuses", "final_raw_sha256", "missing_latency_observations", "local_runner_wall_time_ms"], "properties": {
      "verified_completion": {"type": "boolean"},
      "false_completion": {"type": "boolean"},
      "stop_reason": {"type": "string"},
      "attempted_actions": {"type": "integer", "minimum": 0, "maximum": 3},
      "assessment_count": {"type": "integer", "minimum": 0, "maximum": 3},
      "receipt_statuses": {"type": "array", "items": {"type": "string"}},
      "missing_latency_observations": {"type": "integer", "minimum": 0},
      "local_runner_wall_time_ms": {"type": "number", "minimum": 0},
      "final_raw_sha256": {"$ref": "#/$defs/hash"}
    }, "additionalProperties": true}
  }
}
