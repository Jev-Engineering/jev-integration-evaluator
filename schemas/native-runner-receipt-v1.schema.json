          "type": "integer"
        },
        "schema_version": {
          "const": "1.1"
        },
        "source_identity_valid": {
          "type": "boolean"
        },
        "source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "target_environment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "backend",
        "run_id",
        "request_sha256",
        "authority_reference_sha256",
        "source_manifest_sha256",
        "environment_identity_sha256",
        "schedule_sha256",
        "evidence_kind",
        "integration_verified",
        "activation_eligible",
        "source_identity_valid",
        "scheduled",
        "recorded",
        "exited_zero",
        "cases",
